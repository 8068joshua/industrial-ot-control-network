{
  "name": "modbus_server",
  "protocol": "modbus-tcp",
  "modbusSlaveConfig": {
    "enabled": true,
    "networkInterface": "0.0.0.0",
    "port": 502,
    "bufferMapping": {
      "holdingRegisters": {
        "qwCount": 1024,
        "mwCount": 1024,
        "mdCount": 1024,
        "mlCount": 1024
      },
      "coils": {
        "qxBits": 8192,
        "mxBits": 16
      },
      "discreteInputs": {
        "ixBits": 8192
      },
      "inputRegisters": {
        "iwCount": 1024
      }
    }
  }
}